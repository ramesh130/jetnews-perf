# The part of every trace config the harness builds; see devicelab/lib/perfetto.sh.
#
# Streamed into the output file every few seconds rather than held until the end, so a long run is
# bounded by the device's storage rather than by one in-memory buffer, and a run whose device dies
# part-way still leaves a readable trace behind. DISCARD rather than RING_BUFFER: a trace that
# dropped data says so in its stats, while a ring buffer quietly loses the start of the run.
buffers {
  size_kb: 65536
  fill_policy: DISCARD
}
duration_ms: 900000
write_into_file: true
file_write_period_ms: 2500
flush_period_ms: 10000

# Process and thread names, so anything else in the trace can be attributed to the demo at all.
data_sources {
  config {
    name: "linux.process_stats"
    process_stats_config {
      scan_all_processes_on_start: true
    }
  }
}

# The installed packages with their version codes: the trace itself records which build of the demo
# it measured, independently of the run metadata written beside it.
data_sources {
  config {
    name: "android.packages_list"
  }
}

# --- startup ---
# What an app startup is read from: the platform's launch events, the demo's main thread, and every
# frame until the first one is drawn. Wanted by the startup scenario, whose metrics are Perfetto's
# `android.startup.startups` and `android.startup.time_to_display` stdlib modules
# (https://github.com/ramesh130/perfettoagent/issues/5).
#
# Each atrace category is here for a table those modules read:
#   am       system_server's `launchingActivity#N:*` slices, from which API 33+ startups are found at
#            all, and the app's `bindApplication`, `activityStart` and `activityResume`, which type a
#            startup as cold; also `reportFullyDrawn`, which TTFD starts from
#   wm       the window manager's side of the launch: starting window, transition, focus
#   view     `Choreographer#doFrame` on the main thread and `DrawFrame` on the RenderThread, which
#            are `android_frames`, and TTID is the end of the first `DrawFrame` of a startup
#   dalvik   class loading, verification and GC, which is where much of a cold start's main thread goes
#   res      resource loading, the other place
#   binder_driver  binder transactions, so a main thread waiting on another process says which
# and `atrace_apps` adds the demo's own `Trace` sections: Compose's, AndroidX's and Media3's.
#
# Not `gfx`, deliberately. It is SurfaceFlinger's, it was 1.2 million of a twenty-launch trace's 2
# million slices, and nothing a startup is read from needs it: the frames are the app's own `view`
# slices joined to the `frametimeline` source, which the scenario asks for beside this one.
#
# The scheduler events are what `thread_state` is built from: whether the main thread was running,
# runnable, sleeping, or blocked in the kernel. `sched_blocked_reason` adds why a thread blocked
# uninterruptibly — an I/O wait, and the kernel function it waited in — which is how a read on the main
# thread tells itself apart from a lock. `task_newtask` and `task_rename` name the demo's process as the
# zygote forks it, since the process is born after the trace starts; the base config's
# `linux.process_stats` then reads the new pid's /proc entry when the scheduler first shows it.
#
# `compact_sched` encodes the two busiest scheduler events, switch and waking, in Perfetto's packed form,
# which trace processor reads back into the same tables. Twenty launches come to about 75 MB with it.
#
# ref: https://perfetto.dev/docs/data-sources/cpu-scheduling
# ref: https://perfetto.dev/docs/data-sources/atrace
# ref: https://android.googlesource.com/platform/external/perfetto/+/refs/tags/v58.2/src/trace_processor/perfetto_sql/stdlib/android/startup/startups.sql
# ref: https://android.googlesource.com/platform/external/perfetto/+/refs/tags/v58.2/src/trace_processor/perfetto_sql/stdlib/android/startup/time_to_display.sql
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_wakeup_new"
      ftrace_events: "sched/sched_blocked_reason"
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      atrace_categories: "am"
      atrace_categories: "wm"
      atrace_categories: "view"
      atrace_categories: "dalvik"
      atrace_categories: "res"
      atrace_categories: "binder_driver"
      atrace_apps: "com.example.jetnews"
      compact_sched {
        enabled: true
      }
    }
  }
}

# --- frametimeline ---
# SurfaceFlinger's expected and actual timeline for every frame, per layer: which frames missed their
# deadline, and whether the app or the compositor missed it. Wanted by the UI jank measurement (#51).
#
# ref: https://perfetto.dev/docs/data-sources/frametimeline
data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}
